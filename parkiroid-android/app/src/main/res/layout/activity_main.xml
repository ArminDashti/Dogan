<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dogan_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Signal band: brand + connectivity chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brandTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Dogan.Brand" />

            <LinearLayout
                android:id="@+id/connectivityBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_signal_chip"
                android:clickable="true"
                android:contentDescription="@string/settings_section_connectivity"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <View
                    android:id="@+id/signalLamp"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_signal_lamp" />

                <TextView
                    android:id="@+id/connectivityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/disconnected_label"
                    android:textAppearance="@style/TextAppearance.Dogan.Mono" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hubHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/hub_hint"
            android:textColor="@color/dogan_on_surface_secondary"
            android:textSize="14sp" />

        <!-- Watchman bay | gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeWatchmanBtn"
                style="@style/Widget.Dogan.Button.Bay"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/mode_watchman"
                app:icon="@drawable/ic_watchman" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/watchmanSettingsBtn"
                style="@style/Widget.Dogan.Button.Gear"
                android:layout_width="56dp"
                android:layout_height="96dp"
                android:contentDescription="@string/settings_section_watchman"
                android:padding="0dp"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Copilot bay | gear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeCopilotBtn"
                style="@style/Widget.Dogan.Button.Bay"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/mode_copilot"
                app:icon="@drawable/ic_copilot" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copilotSettingsBtn"
                style="@style/Widget.Dogan.Button.Gear"
                android:layout_width="56dp"
                android:layout_height="96dp"
                android:contentDescription="@string/settings_section_copilot"
                android:padding="0dp"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Service lane -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsBtn"
                style="@style/Widget.Dogan.Button.Service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                app:icon="@drawable/ic_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logsBtn"
                style="@style/Widget.Dogan.Button.Service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="@string/logs_title"
                app:icon="@drawable/ic_logs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitBtn"
                style="@style/Widget.Dogan.Button.Service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/exit_app"
                app:icon="@drawable/ic_exit" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
