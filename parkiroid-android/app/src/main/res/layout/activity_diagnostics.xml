<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dogan_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/diagnosticsToolbar"
        style="@style/Widget.Dogan.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dogan_surface_variant"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/diagnostics_title"
        app:titleTextColor="@color/dogan_on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/diagnosticsStatusTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dogan_on_surface"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testInternetBtn"
                style="@style/Widget.Dogan.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/test_internet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testServerApiBtn"
                style="@style/Widget.Dogan.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/test_server_api" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testWebRtcBtn"
                style="@style/Widget.Dogan.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/test_webrtc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runAllTestsBtn"
                style="@style/Widget.Dogan.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/run_all_tests" />

            <LinearLayout
                android:id="@+id/testResultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
