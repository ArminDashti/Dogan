<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/dogan_surface"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/copilotAlertSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copilot_alert" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/copilotDistanceSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copilot_distance_control" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/alert_duration">
            <AutoCompleteTextView
                android:id="@+id/alertDurationInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
