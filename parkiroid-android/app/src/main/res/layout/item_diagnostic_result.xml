<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_diagnostic_card"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:id="@+id/testStatusIndicator"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/testNameTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage_grotesque_semibold"
            android:textColor="@color/dogan_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/testStatusTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/dogan_on_surface" />

        <TextView
            android:id="@+id/testDetailTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:textColor="@color/dogan_on_surface_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
