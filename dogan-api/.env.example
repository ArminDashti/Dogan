# Copy to a local .env (do not commit real secrets).
# Pont OpenAI-compatible gateway: model id prefix picks the upstream provider.
# GET  https://pont.xaigrok.ir/api/v1/models
# POST https://pont.xaigrok.ir/api/v1/chat/completions
# POST https://pont.xaigrok.ir/api/v1/responses
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://pont.xaigrok.ir/api/v1
OPENCODE_GO_MODEL=opencodego-glm-5.3-flash
OPENCODE_GO_PROMPT=Describe this camera image briefly. Note people, vehicles, hazards, or anything unusual.

# MediaMTX streaming (local Docker defaults).
DOGAN_MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
DOGAN_MEDIAMTX_HLS_PUBLIC_URL=http://localhost:8888
DOGAN_MEDIAMTX_API_URL=http://dogan-mediamtx:9997
# T3 overlay only: WebRTC announced host and MediaMTX HTTP auth callback.
DOGAN_MEDIAMTX_ADDITIONAL_HOSTS=2.144.27.124
DOGAN_MEDIAMTX_AUTH_URL=http://dogan-api:8080/dogan/api/v1/mediamtx/auth

# Short-lived stream JWT secret; empty uses DOGAN_JWT_SECRET.
DOGAN_STREAM_TOKEN_SECRET=
DOGAN_STREAM_TOKEN_TTL=3600

# TURN REST credentials for coturn. Empty DOGAN_TURN_DOMAIN disables the TURN hint locally.
# DOGAN_TURN_SECRET is required on T3: docker-compose.t3.yml fails fast when it is unset or empty.
DOGAN_TURN_DOMAIN=
DOGAN_TURN_EXTERNAL_TLS=true
DOGAN_TURN_SECRET=
DOGAN_TURN_TTL=86400
DOGAN_ICE_SERVER_URLS=

# T3 public URLs and relay path.
# DOGAN_MEDIAMTX_WEBRTC_PUBLIC_URL=https://dogan-media.xaigrok.ir
# DOGAN_MEDIAMTX_HLS_PUBLIC_URL=https://dogan-hls.xaigrok.ir
# DOGAN_TURN_DOMAIN=dogan-turn.xaigrok.ir
# Subdomains (443 only): dogan / dogan-api / dogan-media / dogan-hls / dogan-turn — see Docs/modules/public-443-subdomains.md.
