# Copy to a local .env (do not commit real secrets).
# Pont OpenAI-compatible gateway: model id prefix picks the upstream provider.
# GET  https://pont.xaigrok.ir/api/v1/models
# POST https://pont.xaigrok.ir/api/v1/chat/completions
# POST https://pont.xaigrok.ir/api/v1/responses
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://pont.xaigrok.ir/api/v1
OPENCODE_GO_MODEL=opencodego-glm-5.3-flash
OPENCODE_GO_PROMPT=Describe this camera image briefly. Note people, vehicles, hazards, or anything unusual.
